ALTER TABLE cars RENAME TO cars_old;

CREATE TABLE cars (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    brand TEXT NOT NULL,
    model TEXT NOT NULL,
    engine_capacity_cm3 INTEGER NOT NULL,
    horse_power INTEGER NOT NULL,
    registration_number TEXT NOT NULL UNIQUE,
    initial_mileage_km REAL NOT NULL,
    mileage_km REAL NOT NULL
);

INSERT INTO cars(
    id,
    brand,
    model,
    engine_capacity_cm3,
    horse_power,
    registration_number,
    initial_mileage_km,
    mileage_km
)
SELECT
    id,
    brand,
    model,
    engine_capacity_cm3,
    horse_power,
    registration_number,
    initial_mileage_km,
    mileage_km
FROM cars_old;

DROP TABLE cars_old;

ALTER TABLE refuel_entries RENAME TO refuel_entries_old;

CREATE TABLE refuel_entries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    car_id INTEGER NOT NULL REFERENCES cars(id) ON DELETE CASCADE,
    created_at_epoch_millis INTEGER NOT NULL,
    fuel_liters REAL,
    odometer_km REAL NOT NULL
);

INSERT INTO refuel_entries(
    id,
    car_id,
    created_at_epoch_millis,
    fuel_liters,
    odometer_km
)
SELECT
    id,
    car_id,
    created_at_epoch_millis,
    fuel_liters,
    odometer_km
FROM refuel_entries_old;

DROP TABLE refuel_entries_old;
