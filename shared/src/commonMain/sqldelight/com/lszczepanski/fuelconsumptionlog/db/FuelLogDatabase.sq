CREATE TABLE cars (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    brand TEXT NOT NULL,
    model TEXT NOT NULL,
    engine_capacity_cm3 INTEGER NOT NULL,
    horse_power INTEGER NOT NULL,
    registration_number TEXT NOT NULL UNIQUE,
    initial_mileage_km REAL NOT NULL,
    mileage_km REAL NOT NULL
);

CREATE TABLE refuel_entries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    car_id INTEGER NOT NULL REFERENCES cars(id) ON DELETE CASCADE,
    created_at_epoch_millis INTEGER NOT NULL,
    fuel_liters REAL,
    odometer_km REAL NOT NULL
);

CREATE TABLE app_settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK(id = 1),
    unit_system TEXT NOT NULL
);

selectAllCars:
SELECT *
FROM cars
ORDER BY brand, model;

selectByRegistration:
SELECT *
FROM cars
WHERE registration_number = ?;

countByRegistration:
SELECT COUNT(*)
FROM cars
WHERE registration_number = ?;

selectCarById:
SELECT *
FROM cars
WHERE id = ?;

insertCar:
INSERT INTO cars(
    brand,
    model,
    engine_capacity_cm3,
    horse_power,
    registration_number,
    initial_mileage_km,
    mileage_km
)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateCarMileage:
UPDATE cars
SET mileage_km = ?
WHERE id = ?;

selectRefuelsByCarId:
SELECT *
FROM refuel_entries
WHERE car_id = ?
ORDER BY created_at_epoch_millis DESC;

insertRefuel:
INSERT INTO refuel_entries(
    car_id,
    created_at_epoch_millis,
    fuel_liters,
    odometer_km
)
VALUES (?, ?, ?, ?);

updateRefuel:
UPDATE refuel_entries
SET fuel_liters = ?,
    odometer_km = ?
WHERE id = ?;

insertDefaultSettings:
INSERT OR IGNORE INTO app_settings(id, unit_system)
VALUES (1, 'METRIC');

selectUnitSystem:
SELECT unit_system
FROM app_settings
WHERE id = 1;

updateUnitSystem:
UPDATE app_settings
SET unit_system = ?
WHERE id = 1;
