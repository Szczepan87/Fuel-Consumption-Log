CREATE TABLE cars (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    brand TEXT NOT NULL,
    model TEXT NOT NULL,
    engine_capacity_cm3 INTEGER NOT NULL,
    horse_power INTEGER NOT NULL,
    registration_number TEXT NOT NULL UNIQUE,
    mileage_km INTEGER NOT NULL
);

CREATE TABLE refuel_entries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    car_id INTEGER NOT NULL REFERENCES cars(id) ON DELETE CASCADE,
    created_at_epoch_millis INTEGER NOT NULL,
    fuel_liters REAL,
    odometer_km INTEGER NOT NULL,
    is_draft INTEGER NOT NULL DEFAULT 1
);

selectAllCars:
SELECT *
FROM cars
ORDER BY brand, model;

selectByRegistration:
SELECT *
FROM cars
WHERE registration_number = ?;

countByRegistration:
SELECT COUNT(*)
FROM cars
WHERE registration_number = ?;

selectCarById:
SELECT *
FROM cars
WHERE id = ?;

insertCar:
INSERT INTO cars(
    brand,
    model,
    engine_capacity_cm3,
    horse_power,
    registration_number,
    mileage_km
)
VALUES (?, ?, ?, ?, ?, ?);

updateCarMileage:
UPDATE cars
SET mileage_km = ?
WHERE id = ?;

selectRefuelsByCarId:
SELECT *
FROM refuel_entries
WHERE car_id = ?
ORDER BY created_at_epoch_millis DESC;

insertRefuel:
INSERT INTO refuel_entries(
    car_id,
    created_at_epoch_millis,
    fuel_liters,
    odometer_km,
    is_draft
)
VALUES (?, ?, ?, ?, ?);

updateRefuel:
UPDATE refuel_entries
SET fuel_liters = ?,
    is_draft = ?
WHERE id = ?;

